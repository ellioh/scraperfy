# --- Panel admin ---
ADMIN_PASSWORD=changeme
ADMIN_TOKEN_SECRET=changeme32chars

# --- MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scraperfy
# true si el proveedor exige TLS (PlanetScale, Aiven, RDS, etc.)
DB_SSL=false
# Conexiones simultaneas por instancia (en Vercel/serverless mantenlo bajo)
DB_POOL_SIZE=5

# --- n8n (opcional) ---
# Webhook que se dispara cuando llega una solicitud nueva desde /contacto
N8N_WEBHOOK_URL=
# Si lo defines, se envia como header X-Scraperfy-Secret (Header Auth en el nodo Webhook)
N8N_WEBHOOK_SECRET=
