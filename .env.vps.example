# Plantilla para la VPS (docker compose). Copiar a `.env` y completar:
#   cp .env.vps.example .env
# NUNCA subir el .env real al repositorio (ya esta en .gitignore).
#
# Generar secretos aleatorios:   openssl rand -base64 32

# --- Panel admin ---
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# --- MySQL (contenedor interno; DB_HOST lo fija docker-compose a "mysql") ---
DB_ROOT_PASSWORD=
DB_NAME=scraperfy
# No puede ser "root": el contenedor crea este usuario con permisos solo sobre DB_NAME
DB_USER=scraperfy
DB_PASSWORD=
DB_POOL_SIZE=10

# --- Dominio (solo si usas el Caddy incluido: docker compose --profile proxy up -d) ---
DOMAIN=scraperfy.com

# --- Puerto local de la app (solo 127.0.0.1) ---
APP_PORT=3000

# --- n8n (opcional) ---
# Webhook que se dispara al llegar una solicitud desde /contacto
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
